#!/usr/bin/env bash

##############################################################################
##
##  Gradle start up script for UN*X
##
##############################################################################

# Attempt to set APP_HOME
# Resolve links: $0 may be a link
PRG="$0"
# Need this for relative symlinks.
while [ -h "$PRG" ] ; do
    ls -ld "$PRG"
    link=$(expr "$PRG" : '.*-> \(.*\)$')
    case $link in
      /*) PRG="$link" ;;
      *) PRG=$(dirname "$PRG")"/$link" ;;
    esac
done
SAVED="$(cd "$(dirname "$PRG")" && pwd)"
cd "$SAVED" || exit 1
APP_HOME=$(pwd -P)
cd "$OLDPWD" || exit 1

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")

# Add default JVM options here
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Use the maximum available, or use the default if we know it is ava available.
if [ -z "$JAVA_HOME" ] ; then
    if command -v java >/dev/null 2>&1 ; then
        set -- $(java -XshowSettings:properties -version 2>&1 | grep 'java.home' | awk '{print $3}')
        JAVA_HOME=$1
    fi
fi

# Increase the default stack size.
DEFAULT_JVM_OPTS="$DEFAULT_JVM_OPTS \"-Xss1m\""

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
        exit 1
    fi
else
    JAVACMD="java"
    if ! command -v java >/dev/null 2>&1
    then
        echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
        exit 1
    fi
fi

# Escape application args
save () {
    for arg do
        arg=$(printf '%s\n' "$arg" | sed "s/'/'\\\\''/g")
        printf '%s\n' "'$arg'"
    done
    echo " "
}
APP_ARGS=$(save "$@")
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar
GRADLE_OPTS="$DEFAULT_JVM_OPTS $GRADLE_OPTS"
export CLASSPATH GRADLE_OPTS

exec "$JAVACMD" $GRADLE_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
